---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import SocialList from "@/components/page/SocialList.astro";
import { sortMDByDate } from "@/utils";
import { Image } from "astro:assets";

const MAX_POSTS = 10;
const allPosts = await getCollection("post");
const visiblePosts = allPosts.filter((post) => !post.data.hidden);
const allPostsByDate = sortMDByDate(visiblePosts).slice(0, MAX_POSTS);
---

<PageLayout meta={{ title: "Steve Simkins" }}>
  <h1 class="title mb-4">/</h1>
  <section>
    <p class="mb-4">
      DX Engineer with a passion for developer tooling that advances an open
      web. Currently working at <a
        href="https://stablecore.com"
        target="_blank"
        rel="noopener noreferrer"
        class="style-link">Stablecore</a
      >
      with other <a href="/projects" class="style-link">projects</a>
      in my spare time. This site catalogs my various writings and interests. See
      what I'm up to <a href="/now" class="style-link">now</a>!
    </p>
    <SocialList />
    <p>
      Or anywhere with my handle <span class="text-accent">@stevedylandev</span>
    </p>
  </section>
  <section aria-label="Blog post list" class="mt-16">
    <h2 class="title mb-4 text-xl">Posts</h2>
    <ul class="space-y-4 sm:space-y-2">
      {
        allPostsByDate.map((p) => (
          <li class="flex flex-col gap-x-2 sm:flex-row">
            <PostPreview post={p} />
          </li>
        ))
      }
    </ul>
  </section>
  <section class="mt-16">
    <h2 class="title mb-4 text-xl">Extras</h2>
    <ul class="space-y-4 sm:space-y-2">
      <li>
        <a
          href="https://sequoia.pub"
          target="_blank"
          rel="noopener noreferrer"
          class="style-link inline-block"
          >
          <svg xmlns="http://www.w3.org/2000/svg" class="inline-block h-5 w-5" viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="none" stroke="#888" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 22V9m3 8h1a5 5 0 0 0 .999-9.9C16.999 4.338 15 2 12 2S7.001 4.338 7.001 7.1A5.002 5.002 0 0 0 8 17h1m3-2l2.5-2.5M12 13l-2.5-2.5M10 22h4" />
          </svg>
          Sequoia
        </a>:
        <p class="inline-block sm:mt-2">Content publishing CLI for ATProto</p>
      </li>
      <li>
        <a
          href="https://bhvr.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="style-link inline-block"
          >
          <svg xmlns="http://www.w3.org/2000/svg" class="inline-block h-4 w-4" viewBox="0 0 32 32">
            <path d="M0 0h32v32H0z" fill="none" />
            <g fill="#888">
              <path d="M7.5 6c-.28 0-.5.251-.5.571v.858c0 .32.22.571.5.571s.5-.251.5-.571V6.57C8 6.251 7.78 6 7.5 6" />
              <path d="M31 16.423c0-5.778-4.703-10.446-10.5-10.446h-3.86a.3.3 0 0 1-.067-.008A2.5 2.5 0 0 0 17 4.561A2.56 2.56 0 0 0 14.43 2a2.57 2.57 0 0 0-1.865.799a5.5 5.5 0 0 0-2.767.031l-7.14 1.94h-.004A2.245 2.245 0 0 0 1 6.927v.507a6.46 6.46 0 0 0 1.003 3.467v1.709c0 .21.18.39.39.39h1.22c.12 0 .229-.058.301-.146q.512.34 1.086.581v.002h-.719c-.704 0-1.281.577-1.281 1.282C3 15.423 3.577 16 4.281 16h.944c.53 1.81 1.951 3.288 3.775 3.817v.636l-.41-.148a.04.04 0 0 1-.017-.006q-.007-.005-.016-.005l-.032-.011A4.8 4.8 0 0 0 6.742 20c-2.586.087-4.695 2.206-4.738 4.804a4.896 4.896 0 0 0 4.89 4.977h14.052c2.71 0 5-1.773 5.774-4.225c2.6-2.22 4.28-5.685 4.28-9.134M13.899 4.355A.57.57 0 0 1 14.43 4c.323 0 .57.254.57.561a.55.55 0 0 1-.288.48l-.99.553l1.092 1.482l.01.012c.434.552 1.1.89 1.816.89h3.86c4.703 0 8.5 3.782 8.5 8.445c0 3.194-1.776 6.466-4.39 8.23l-.19.128a7.83 7.83 0 0 1-4.31-.303l-9.11-3.3v-2.124c1.136-.093 2.111-.505 2.831-1.211c.824-.81 1.263-1.957 1.263-3.312a.5.5 0 0 0-1 0c0 1.135-.363 2.009-.964 2.598c-.567.558-1.39.904-2.438.941l-.582-.064c-1.56-.172-2.847-1.47-3.074-3.07H8.31c.959 0 1.8-.503 2.276-1.253l.003-.006q.099-.158.175-.33l.39-.878c.202-.282.3-.64.3-1.059c0-.924-.691-1.657-1.412-2.124c-.74-.478-1.674-.786-2.452-.786H6.26a1.38 1.38 0 0 1-1.277-.859l-.524-1.289l5.863-1.592a3.48 3.48 0 0 1 2.26.146l.94.394zm-3.446 7.055c0 .315-.083.457-.16.533H7.53c-1.99 0-3.68-1.28-4.289-3.054c.342-.21.625-.51.813-.879l.003.01A2.38 2.38 0 0 0 6.26 9.5h1.33c.552 0 1.3.232 1.909.626c.628.406.954.878.954 1.284" />
            </g>
          </svg>
          bhvr
        </a>:
        <p class="inline-block sm:mt-2">
          Modern framework for building web apps using Bun, Hono, Vite, and
          React
        </p>
      </li>
      <li>
        <a
          href="https://ethglobal.com/showcase/cosmic-cowboys-3q0co"
          target="_blank"
          rel="noopener noreferrer"
          class="style-link inline-block"
          >
          <svg xmlns="http://www.w3.org/2000/svg" class="inline-block h-4 w-4" viewBox="0 0 256 256">
            <path d="M0 0h256v256H0z" fill="none" />
            <path fill="#888" d="M216 120a8 8 0 0 0-6.78 3.76A180 180 0 0 1 195.41 143l-1.63-8.57l-15.46-81.36a16 16 0 0 0-25.72-9.55l-.13.1L128 64l-24.47-20.38l-.13-.1a16 16 0 0 0-25.72 9.53l-15.45 81.33l-1.64 8.62a179 179 0 0 1-13.81-19.25A8 8 0 0 0 40 120a40 40 0 0 0 0 80h176a40 40 0 0 0 0-80M76.68 144h102.63l2.54 13.35a113.3 113.3 0 0 1-27.35 19c-15.4 7.42-26.44 7.65-26.5 7.65c-.33 0-25.49-.4-53.86-26.6Z" />
          </svg>
          Cosmic Cowboys
        </a>:
        <p class="inline-block sm:mt-2">
          EthGlobal 2023 hackathon winning project
        </p>
      </li>
      <li>
        <a
          href="https://steve.photo"
          target="_blank"
          rel="noopener noreferrer"
          class="style-link inline-block"
          >
          <svg xmlns="http://www.w3.org/2000/svg" class="inline-block h-4 w-4 sm:mt-2" viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="#888" d="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2m8 3a5 5 0 0 0-5 5a5 5 0 0 0 5 5a5 5 0 0 0 5-5a5 5 0 0 0-5-5m0 2a3 3 0 0 1 3 3a3 3 0 0 1-3 3a3 3 0 0 1-3-3a3 3 0 0 1 3-3" />
          </svg>
          Photos
        </a>:
        <p class="inline-block sm:mt-2">My personal photography portfolio</p>
      </li>
      <li>
        <a
          href="https://stablecore.com"
          target="_blank"
          rel="noopener noreferrer"
          class="style-link inline-block"
          ><Image
            height="100"
            width="100"
            loading="lazy"
            src="https://files.stevedylan.dev/stablecore.png"
            class="inline-block h-4 w-4"
            alt="Stablecore company logo"
          /> Stablecore
        </a>:
        <p class="inline-block sm:mt-2">
          Where I'm currently working as a Senior Solutions Engineer
        </p>
      </li>
      <li>
        <a
          href="https://dino.stevedylan.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="style-link inline-block"
          ><Image
            height="100"
            width="100"
            loading="lazy"
            src="https://files.stevedylan.dev/dino-icon-2.png"
            class="inline-block h-4 w-4"
            alt="Pixel art dinosaur icon"
          /> Dino
        </a>:
        <p class="inline-block sm:mt-2">Just the dino</p>
      </li>
    </ul>
  </section>
</PageLayout>
