---
export const prerender = false;

import { env } from "cloudflare:workers";
import PageLayout from "@/layouts/Base.astro";
import { type Mention, readMentions } from "@/utils";

const meta = {
	title: "/webmentions",
	description: "Webmentions received across my site",
};

const mentions = await readMentions(env.WEBMENTIONS);

// Group by the page that was mentioned, newest mention first within each group,
// and list the most-mentioned pages first.
const byTarget = new Map<string, Mention[]>();
for (const m of mentions) {
	byTarget.set(m.target, [...(byTarget.get(m.target) ?? []), m]);
}
const groups = [...byTarget.entries()]
	.map(([target, items]) => ({
		target,
		items: items.sort(
			(a, b) =>
				new Date(b.verifiedAt).getTime() - new Date(a.verifiedAt).getTime(),
		),
	}))
	.sort((a, b) => b.items.length - a.items.length);
---

<PageLayout meta={meta}>
  <div class="space-y-6">
    <h1 class="title mb-6">/webmentions</h1>
    <p class="text-zinc-300">
      Pages and posts around the web that have linked here.
    </p>
    {
      groups.length === 0 ? (
        <p class="text-zinc-400">No webmentions yet.</p>
      ) : (
        <div class="space-y-8">
          {groups.map((group) => (
            <section>
              <h2 class="font-semibold">
                <a class="style-link" href={group.target}>
                  {new URL(group.target).pathname}
                </a>
                <span class="ml-2 text-sm text-zinc-500">
                  {group.items.length}
                </span>
              </h2>
              <ul class="mt-3 space-y-2 text-sm">
                {group.items.map((m) => (
                  <li class="flex items-center gap-2">
                    <a
                      class="underline hover:text-link"
                      href={m.source}
                      target="_blank"
                      rel="nofollow ugc noopener noreferrer"
                    >
                      {new URL(m.source).host}
                    </a>
                    <span class="text-zinc-500">
                      {new Date(m.verifiedAt).toLocaleDateString()}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </div>
</PageLayout>
